# 好室宅吉便 - 環境變數
# 複製此檔為 .env 後填入實際值

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haoshih

# Redis
REDIS_URL=redis://localhost:6379

# Meilisearch
MEILI_URL=http://localhost:7700
MEILI_KEY=haoshih_dev_key_change_in_production

# S3 (圖片上傳)
S3_BUCKET=haoshih-assets
S3_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# TDX (交通資料)
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
